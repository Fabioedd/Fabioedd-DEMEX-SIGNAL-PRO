{
  "market_mode": "OTC",
  "trade_type": "binary",
  "timeframe": "M1",
  "expiry_minutes": 1,
  "minimum_payout_percent": 84,
  "minimum_confidence": 70,
  "scan_interval_seconds": 2,
  "entry_confirmation_window_seconds": 10,
  "candles_count": 250,
